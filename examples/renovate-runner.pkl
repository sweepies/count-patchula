amends "../Rustovate.pkl"

managers = new Listing { "npm"; "github-actions"; "mise"; "regex" }
prs { dashboard = true }
rules = new Listing {
  new Rule {
    note = "Alchemy, Effect, overrides and SvelteKit must update together."
    select {
      managers = new Listing { "npm" }
      packages = new Listing { "alchemy"; "@alchemy.run/**"; "effect"; "@effect/**"; "@sveltejs/kit" }
    }
    apply { group = "alchemy, effect and sveltekit" }
  }
  new Rule {
    note = "OpenBao authorizes refs/heads/main; a workflow SHA changes job_workflow_ref."
    select {
      managers = new Listing { "github-actions" }
      dependencies = new Listing { "sweepies/ops-workflows" }
    }
    apply { digest = false }
  }
}
extractors = new Listing {
  new Extractor {
    paths = new Listing { "infra/versions.ts" }
    patterns = new Listing { #"// renovate: datasource=(?<source>npm) depName=(?<dependency>renovate)\s+export const RENOVATE_VERSION = "(?<current>[^"]+)";"# }
  }
  new Extractor {
    paths = new Listing { "infra/versions.ts" }
    patterns = new Listing { #"// renovate: datasource=(?<source>github-releases) depName=(?<dependency>jdx/mise)\s+export const MISE_VERSION = "(?<current>[^"]+)";"# }
    extract = #"^v?(?<version>.*)$"#
  }
}
