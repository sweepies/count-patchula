// Count Patchula's site: VitePress output served as Workers static assets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "count-patchula",
  "compatibility_date": "2026-10-21",
  // Production is served only on count-patchula.sweepy.dev, so search engines
  // see one copy. Preview URLs, on workers.dev, still serve each branch's
  // uploaded version under its own alias.
  "routes": [{ "pattern": "count-patchula.sweepy.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./.vitepress/dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
