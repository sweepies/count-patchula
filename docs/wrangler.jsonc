// Count Patchula's site: Astro Starlight output served as Workers static assets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "count-patchula",
  "compatibility_date": "2026-10-21",
  // Production is served only on count-patchula.sweepy.dev, so search engines
  // see one copy. Preview URLs, on workers.dev, still serve each branch's
  // uploaded version under its own alias.
  "routes": [{ "pattern": "count-patchula.sweepy.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    // Astro writes every page as dir/index.html and Starlight links to it as
    // /dir/, so /dir redirects to /dir/.
    "html_handling": "force-trailing-slash"
  }
}
