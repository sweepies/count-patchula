{
  "schemaVersion": 1,
  "rules": [
    {
      "id": "cargo-pre1-breaking",
      "departure": 20,
      "classification": "field-mismatch",
      "managers": ["cargo"],
      "field": "updates.updateType",
      "predicate": "cargo-pre1-breaking"
    },
    {
      "id": "default-added-digest",
      "departure": 7,
      "classification": "field-mismatch",
      "managers": ["github-actions", "dockerfile", "compose"],
      "field": "updates.newDigest",
      "predicate": "digest-added"
    },
    {
      "id": "default-digest-only-pin",
      "departure": 7,
      "classification": "rustovate-extra",
      "managers": ["github-actions", "dockerfile", "compose"],
      "field": "updates",
      "predicate": "digest-pin-only"
    }
  ]
}
