#!/usr/bin/env bash
#MISE description="Compile and link native dependencies with the mise-pinned toolchain"
# cc-rs detects clang and supplies Rust's triple, while Zig omits the vendor.
args=()
for arg in "$@"; do
  case "$arg" in
    --target=*-unknown-linux-*) arg="${arg/-unknown-linux-/-linux-}" ;;
    # rustc asks for this erratum workaround on aarch64; Zig's lld has no such flag.
    -Wl,--fix-cortex-a53-843419) continue ;;
  esac
  args+=("$arg")
done
# Without it, Zig builds its runtime for the build machine's CPU, and a binary
# from an AVX-512 runner dies with SIGILL on a runner without it.
exec zig cc -mcpu=baseline "${args[@]}"
