#!/usr/bin/env bash
#MISE description="Compile and link native dependencies with the mise-pinned toolchain"
# cc-rs detects clang and supplies Rust's triple, while Zig omits the vendor.
args=()
for arg in "$@"; do
  case "$arg" in
    --target=*-unknown-linux-*) arg="${arg/-unknown-linux-/-linux-}" ;;
  esac
  args+=("$arg")
done
exec zig cc "${args[@]}"
