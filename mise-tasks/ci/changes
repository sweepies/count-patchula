#!/usr/bin/env nu
#MISE description="Decide which CI jobs a push or pull request needs; GitHub Actions only"
# Reads GH_TOKEN, REPO, EVENT, PR, BEFORE and AFTER, and writes rust and docs
# to $GITHUB_OUTPUT. CI runs this file directly with only nu installed.

# The changed paths, or "unknown" when GitHub cannot list them all.
def changed [] {
  if $env.EVENT == "pull_request" {
    return (^gh api $"repos/($env.REPO)/pulls/($env.PR)/files" --paginate --slurp | from json | flatten | get filename)
  }
  if $env.BEFORE == ("0" | fill -c "0" -w 40) {
    return ["unknown"]
  }
  let files = ^gh api $"repos/($env.REPO)/compare/($env.BEFORE)...($env.AFTER)" | from json | get files
  # The compare API lists at most 300 files; assume more means everything.
  if ($files | length) >= 300 { ["unknown"] } else { $files | get filename }
}

def main [] {
  let ignored = [conformance/README.md README.md AGENTS.md CLAUDE.md LICENSE .gitignore .deepsource.toml socket.yml communique.toml tak.toml]
  let files = changed
  # An empty list is unexpected, so it runs everything.
  let files = if ($files | is-empty) { ["unknown"] } else { $files }
  mut rust = false
  mut docs = false
  for file in $files {
    match $file {
      "unknown" | "mise.toml" | "tasks.toml" | "mise.lock" | ".github/workflows/ci.yml" => {
        $rust = true
        $docs = true
      }
      # The conformance tests read the departures page.
      "docs/src/content/docs/renovate/departures.md" => {
        $rust = true
        $docs = true
      }
      $f if ($f | str starts-with "docs/") => { $docs = true }
      $f if ($f in $ignored) or ([assets/ skills/ .claude/] | any {|dir| $f | str starts-with $dir }) => {}
      # The lint job checks workflows on every change.
      $f if $f == "action.yml" or ($f | str starts-with ".github/workflows/") => {}
      # Anything else may change what the Rust jobs check.
      _ => { $rust = true }
    }
  }
  $"rust=($rust)\ndocs=($docs)\n" | save --append $env.GITHUB_OUTPUT
  $"Rust jobs: ($rust)\nDocs build: ($docs)\n" | save --append $env.GITHUB_STEP_SUMMARY
}
