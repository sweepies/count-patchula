#!/usr/bin/env nu
#MISE description="Run every check GitHub runs, one after another, and keep each stage's log"
#MISE env.PATCHULA_RECORD = "0"
#MISE env.CARGO_TERM_COLOR = "never"
#USAGE flag "--log-dir <dir>" help="Where the stage logs go; a new temporary directory by default"

def main [--log-dir: string] {
  # nu-lint-ignore: check_typed_flag_before_use
  let log_dir = $log_dir | default { mktemp -d -t patchula-ci.XXXXXX }
  mkdir $log_dir
  print $"CI full logs: ($log_dir)"
  for task in [lint build fixtures:check test:unit test:tools docs:build] {
    let log = $log_dir | path join $"($task | str replace --all ':' '-').log"
    let failed = try { ^mise run $task o+e> $log; false } catch { true }
    print --raw --no-newline (open --raw $log)
    if $failed {
      let tests = open --raw $log | lines | parse --regex '^test (?<name>.*) \.\.\. FAILED$' | get name
      let tests = if ($tests | is-empty) { "see-log" } else { $tests | each {|name| $"($name)," } | str join }
      # Keep the path and test names even when a caller filters for test result:.
      # nu-lint-ignore: errors_to_stderr
      print $"test result: FAILED; stage=($task); failing-tests=($tests); full-log=($log)"
      exit 1
    }
  }
}
