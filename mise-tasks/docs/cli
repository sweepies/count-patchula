#!/usr/bin/env bash
#MISE description="Generate the CLI reference page, man page and bash/zsh/fish completions from usage derive"
#USAGE env "PATCHULA_BIN" help="Read the spec from this already-built binary instead of building one"
set -euo pipefail
mkdir -p generated/completions
${PATCHULA_BIN:-cargo run --quiet --locked -p patchula-cli --} __usage_spec__ > generated/patchula.usage.kdl
usage lint generated/patchula.usage.kdl
# Front matter must open the page, so drop the comment usage writes above it.
page=docs/src/content/docs/reference/cli.md
usage generate markdown --file generated/patchula.usage.kdl --template spec=docs/.usage/spec.md.tera --template command=docs/.usage/command.md.tera --out-file "$page"
sed -i.orig '1{/^<!-- @generated by usage-cli/d;}' "$page" && rm "$page.orig"
usage generate manpage --file generated/patchula.usage.kdl --out-file generated/patchula.1
for shell in bash zsh fish; do
  usage generate completion "$shell" patchula --file generated/patchula.usage.kdl > "generated/completions/patchula.$shell"
done
