#!/usr/bin/env nu
#MISE description="Generate the CLI reference page, man page and bash/zsh/fish completions from usage derive; PATCHULA_BIN reads the spec from an already-built binary"
#MISE sources=["Cargo.toml", "crates/cli/**/*", "docs/.usage/*"]
#MISE outputs=["generated/patchula.usage.kdl", "generated/patchula.1", "generated/completions/*", "docs/src/content/docs/reference/cli.md"]

def main [] {
  let spec = "generated/patchula.usage.kdl"
  let page = "docs/src/content/docs/reference/cli.md"
  mkdir generated/completions
  if ($env.PATCHULA_BIN? | is-empty) {
    ^cargo run --quiet --locked -p patchula-cli -- __usage_spec__
  } else {
    ^$env.PATCHULA_BIN __usage_spec__
  } | save --force $spec
  ^usage lint $spec
  ^usage generate markdown --file $spec --template spec=docs/.usage/spec.md.tera --template command=docs/.usage/command.md.tera --out-file $page
  # Front matter must open the page, so drop the comment usage writes above it.
  let lines = open --raw $page | lines
  if ($lines | first | str starts-with "<!-- @generated by usage-cli") {
    $lines | skip 1 | str join "\n" | $in + "\n" | save --force $page
  }
  ^usage generate manpage --file $spec --out-file generated/patchula.1
  for shell in [bash zsh fish] {
    ^usage generate completion $shell patchula --file $spec | save --force $"generated/completions/patchula.($shell)"
  }
}
