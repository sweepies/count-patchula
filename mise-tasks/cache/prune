#!/usr/bin/env nu
#MISE description="Delete superseded GitHub Actions caches: all but the newest entry of each key prefix, or every entry on a ref"
#USAGE flag "--ref <ref>" default="refs/heads/main" help="Git ref whose caches to prune, such as refs/pull/61/merge"
#USAGE flag "--all" help="Delete every cache on the ref instead of keeping the newest per prefix"
#USAGE flag "--drop-others" help="Also delete caches on the ref that match none of the prefixes, such as retired generations"
#USAGE arg "[prefix]..." help="Cache key prefixes; each keeps only its newest entry"
# Needs GH_TOKEN with actions: write and GH_REPO. CI runs this file directly
# with only nu installed, so nu parses its arguments.

# The ref's caches, newest first, optionally only those whose key starts with
# a prefix.
def list [ref: string, prefix?: string] {
  let key = if $prefix == null { [] } else { [--key $prefix] }
  ^gh cache list --ref $ref --limit 1000 --sort created_at --order desc --json id,key,sizeInBytes ...$key | from json
}

# Deletes all but the first $keep entries. A failed delete is a warning, since
# the next run tries again.
def delete [keep: int] {
  let entries = $in
  for entry in ($entries | first $keep) {
    print $"keep   ($entry.key)"
  }
  let doomed = $entries | skip $keep
  for entry in $doomed {
    print $"delete ($entry.key)"
    try { ^gh cache delete ($entry.id | into string) } catch { print $"::warning::could not delete cache ($entry.key)" }
  }
  let freed = $doomed | reduce -f 0 {|entry, total| $total + $entry.sizeInBytes }
  print $"deleted ($doomed | length) entries, ($freed // 1048576) MB"
}

def main [--ref: string = "refs/heads/main", --all, --drop-others, ...prefixes: string] {
  if $all {
    list $ref | delete 0
    return
  }
  if ($prefixes | is-empty) {
    error make --unspanned {msg: "name at least one key prefix, or pass --all"}
  }
  for prefix in $prefixes {
    list $ref $prefix | delete 1
  }
  if $drop_others {
    print "caches matching no prefix:"
    list $ref | where {|entry| not ($prefixes | any {|prefix| $entry.key | str starts-with $prefix }) } | delete 0
  }
}
