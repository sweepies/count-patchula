#!/usr/bin/env bash
#MISE description="Look up and plan every corpus dependency, then summarize the report; fails when a branch fails to plan"
#MISE tools.jq = "1.8.2"
#USAGE flag "--cache <dir>" required=#true help="Registry cache directory, kept between runs"
#USAGE flag "--out <file>" default="corpus-report.json" help="Where the JSON report goes"
#USAGE flag "--summary <file>" help="Append the Markdown summary here instead of printing it"
set -euo pipefail
report="$(realpath -m "${usage_out:?}")"
cache="$(realpath -m "${usage_cache:?}")"
log="$(mktemp)"
mkdir -p "$cache"
mise run corpus:check --cache "$cache" > "$report" 2> "$log" || { grep -v '^[-+@ ]' "$log" | tail -40; exit 1; }
{
  echo '### Corpus'
  echo '```'
  grep -E '^patchula' "$log" || true
  jq -r '.repositories[] | "\(.repository): \([.packageFiles[].dependencies[]] | length) dependencies, \([.packageFiles[].dependencies[].updates[]] | length) updates", ((.warnings // [])[] | "  warning: \(.)")' "$report"
  jq -r '.actions.branches | group_by(.status) | map("\(.[0].status): \(length) branches") | .[]' "$report"
  jq -r '.actions.branches[] | select(.status == "skipped" or .status == "error") | "\(.status) \(.branch): \(.reason)"' "$report"
  echo '```'
} >> "${usage_summary:-/dev/stdout}"
errors=$(jq '[.actions.branches[] | select(.status == "error")] | length' "$report")
if [ "$errors" != 0 ]; then
  echo "::error::$errors corpus branches failed to plan"
  exit 1
fi
