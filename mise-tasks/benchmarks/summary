#!/usr/bin/env bash
#MISE description="Append the tak timing summary, when there is one, as preformatted Markdown"
#USAGE flag "--out <file>" default="/dev/stdout" help="Markdown file to append to"
set -euo pipefail
summary=benchmark-results/summary.txt
[ -f "$summary" ] || exit 0
{
  printf '<pre>\n'
  cat "$summary"
  printf '</pre>\n'
} >> "${usage_out:?}"
