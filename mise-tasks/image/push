#!/usr/bin/env nu
#MISE description="Publish the image image:build made, with apko's SBOMs, as its version and, unless it is a prerelease, latest; needs a registry login"
#MISE tools={apko="1.4.13"}
#USAGE flag "--repository <repository>" default="ghcr.io/sweepies/count-patchula" help="Image repository to publish to"

# apko builds the image again, offline, from the packages image:build cached,
# and pushes it. The published index must be the one the smoke test ran;
# anything else stops the release. Its digest goes to GITHUB_OUTPUT
# for the provenance attestation, and each platform's for its SBOM's.
def main [--repository: string = "ghcr.io/sweepies/count-patchula"] {
  let out = "target/image" | path expand
  let index = ^tar --extract --to-stdout --file $"($out)/image.tar" index.json
  let tested = $"sha256:($index | hash sha256)"
  # apko adds the creation time itself, so it is not passed again.
  let annotations = $index | from json | get annotations | transpose key value | where key != "org.opencontainers.image.created"
  let version = $annotations | where key == "org.opencontainers.image.version" | first | get value
  let tags = [$"($repository):($version)"] | append (if $version =~ "-" { [] } else { [$"($repository):latest"] })
  let flags = $annotations | each {|annotation| [--annotations $"($annotation.key):($annotation.value)"] } | flatten
  with-env {SOURCE_DATE_EPOCH: (^git log -1 --format=%ct | str trim)} {
    ^apko publish image/apko.yaml ...$tags --cache-dir $"($out)/apk-cache" --offline --ignore-signatures --build-repository-append $"@local ($out)/packages" --vcs=false --sbom=false --image-refs $"($out)/published" ...$flags
  }
  let published = open $"($out)/published" | lines | each { split row "@" | last }
  if $tested not-in $published {
    error make --unspanned {msg: $"published ($published | str join ', '), but the smoke test ran ($tested)"}
  }
  print $"published ($tags | str join ', ') at ($tested)"
  if "GITHUB_OUTPUT" in $env {
    let platforms = $index | from json | get manifests | each {|manifest| $"($manifest.platform.architecture)=($manifest.digest)\n" } | str join
    $"digest=($tested)\n($platforms)" | save --append $env.GITHUB_OUTPUT
  }
}
