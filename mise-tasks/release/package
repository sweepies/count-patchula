#!/usr/bin/env nu
#MISE description="Build static release archives for the given targets into target/dist; the first target must run on this host"
#USAGE arg "<target>..." help="Rust target triples, such as x86_64-unknown-linux-musl"

def main [...targets: string] {
  if ($targets | is-empty) {
    error make --unspanned {msg: "name at least one target"}
  }
  let version = ^cargo metadata --no-deps --format-version 1 | from json | get packages | where name == patchula-cli | first | get version
  let platforms = {
    x86_64-unknown-linux-musl: linux-x64-musl
    aarch64-unknown-linux-musl: linux-arm64-musl
    x86_64-apple-darwin: darwin-x64
    aarch64-apple-darwin: darwin-arm64
  }
  mkdir target/dist
  for target in ($targets | enumerate) {
    let platform = $platforms | get -o $target.item
    if $platform == null {
      error make --unspanned {msg: $"no release platform for ($target.item)"}
    }
    ^rustup target add $target.item
    ^cargo build --release --locked -p patchula-cli --target $target.item
    let bin = $"target/($target.item)/release/patchula"
    # AWS_LC_SYS_NO_JITTER_ENTROPY keeps the jitter-entropy collector out of
    # the binary; a jent_ symbol means it crept back in. Musl builds strip
    # symbols at link time, where nm finds nothing.
    let jitters = ^nm $bin | complete | get stdout | lines | where {|line| $line =~ "jent_"}
    if ($jitters | is-not-empty) {
      error make --unspanned {msg: $"($bin) links jitter-entropy code: ($jitters | first)"}
    }
    if $target.index == 0 {
      with-env {PATCHULA_BIN: $bin} { ^mise run --force docs:cli }
      cp generated/patchula.usage.kdl target/dist/
    }
    let name = $"patchula-v($version)-($platform)"
    let stage = mktemp -d -t patchula-release.XXXXXX
    for file in [
      [from to];
      [$bin bin/patchula]
      [generated/patchula.1 share/man/man1/patchula.1]
      [generated/completions/patchula.bash share/bash-completion/completions/patchula]
      [generated/completions/patchula.zsh share/zsh/site-functions/_patchula]
      [generated/completions/patchula.fish share/fish/vendor_completions.d/patchula.fish]
      [LICENSE LICENSE]
      [README.md README.md]
    ] {
      let to = $stage | path join $file.to
      mkdir ($to | path dirname)
      cp $file.from $to
    }
    ^tar -C $stage -czf $"target/dist/($name).tar.gz" .
    rm -r $stage
    print $"target/dist/($name).tar.gz"
  }
}
