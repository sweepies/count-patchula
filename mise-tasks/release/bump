#!/usr/bin/env nu
#MISE description="Set the workspace to a release version with cargo-release, which writes Cargo.toml and Cargo.lock. With --check, test that a commit is exactly such a bump of its parent instead"
#MISE tools={"github:crate-ci/cargo-release"="1.1.7", gh="2.103.3"}
#USAGE arg "[version]" help="The version to release, such as 0.9.0"
#USAGE flag "--check <commit>" help="Check that this commit only bumps the version of its single parent and that CI passed on that parent on main; print bump=true or bump=false (also to GITHUB_OUTPUT). Needs GH_TOKEN and GITHUB_REPOSITORY"

# The version lives in Cargo.toml's workspace.package alone: the docs fill it in
# when they build and the help snapshot holds a placeholder. So a release
# changes Cargo.toml and Cargo.lock, which lets CI skip a release PR's Rust jobs:
# when a commit changes nothing but the version, the CI run that passed on its
# parent holds for it.
def main [version?: string, --check: string] {
  if $check != null {
    let bump = (is-bump $check) and (parent-passed $check)
    print $"bump=($bump)"
    if "GITHUB_OUTPUT" in $env {
      $"bump=($bump)\n" | save --append $env.GITHUB_OUTPUT
    }
    return
  }
  if $version == null {
    error make --unspanned {msg: "name the version to release"}
  }
  ^cargo release version $version --workspace --execute --no-confirm --allow-branch "*"
}

# True when the commit has one parent and differs from it only in the version:
# Cargo.toml's workspace.package.version, and the versions of the workspace's
# own packages (those without a source) in Cargo.lock. Compared as parsed TOML.
def is-bump [commit: string]: nothing -> bool {
  let parents = ^git show --no-patch --format=%P $commit | str trim | split words
  if ($parents | length) != 1 {
    return false
  }
  let parent = $parents | first
  let changed = ^git diff --name-only $parent $commit | lines
  if ($changed | any {|path| $path not-in [Cargo.toml Cargo.lock] }) {
    return false
  }
  let before = toml-at $parent Cargo.toml
  let after = toml-at $commit Cargo.toml
  let old = $before.workspace.package.version
  let new = $after.workspace.package.version
  if $old == $new or ($before | update workspace.package.version $new) != $after {
    return false
  }
  let lock = toml-at $parent Cargo.lock
  let bumped = $lock | update package {|it|
    $it.package | each {|package|
      if ($package | get --optional source) == null and $package.version == $old {
        $package | update version $new
      } else {
        $package
      }
    }
  }
  $bumped == (toml-at $commit Cargo.lock)
}

def toml-at [commit: string, path: string]: nothing -> record {
  ^git show $"($commit):($path)" | from toml
}

# True when CI passed on the commit's parent as a push to main.
def parent-passed [commit: string]: nothing -> bool {
  let parent = ^git rev-parse $"($commit)^" | str trim
  let runs = ^gh api $"repos/($env.GITHUB_REPOSITORY)/actions/workflows/ci.yml/runs?head_sha=($parent)&event=push&branch=main&status=success" --jq ".total_count" | into int
  $runs > 0
}
