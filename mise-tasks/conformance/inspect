#!/usr/bin/env nu
#MISE description="Summarize triage buckets; optional manager argument prints representative differences"
#USAGE arg "<triage>" help="Path to triage.json"
#USAGE arg "[manager]" help="A manager to print differences for, or warnings"
#USAGE arg "[limit]" default="2" help="Differences per repository, classification and field"

def main [triage: path, manager?: string, limit: int = 2] {
  let triage = open --raw $triage | from json
  let differences = $triage.differences
  if $manager == null {
    $differences
    | each {|d| [$d.repository $d.manager $d.classification $d.field] | str join " / " }
    | uniq --count
    | sort-by value
    | each {|bucket| print $"($bucket.count)\t($bucket.value)" }
    | ignore
    return
  }
  if $manager == warnings {
    for repository in ($triage.patchula.repositories | where {|r| ($r.warnings? | default [] | length) > 0 }) {
      print ({repository: $repository.repository, warnings: $repository.warnings} | to json --raw)
    }
    return
  }
  $differences
  | where manager == $manager and classification != deliberate-departure
  | group-by {|d| [$d.repository $d.classification $d.field] | str join "/" } --to-table
  | each {|bucket| $bucket.items | first $limit }
  | flatten
  | each {|d|
    let actual = $triage.patchula.repositories
      | where repository == $d.repository
      | get -o 0.packageFiles
      | default []
      | where path == $d.packageFile
      | get -o 0.dependencies
      | default []
      | where {|a| $a.manager == $d.manager and $a.name == $d.dependency }
      | get -o 0
    let held_back = $actual | get -o metadata.heldBack
    let line = if $held_back == null { $d } else { $d | insert heldBack $held_back }
    print ($line | to json --raw)
  }
  | ignore
}
