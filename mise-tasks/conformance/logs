#!/usr/bin/env bun
//MISE description="Inspect output snapshot identities and skip reasons without reading upstream source"
//USAGE arg "<log>" help="Renovate JSON log"
//USAGE arg "<repository>" help="Repository, such as owner/repo"
//USAGE arg "[manager]" help="Only this manager's dependencies"
const [path, repository, manager] = process.argv.slice(2);
for (const line of (await Bun.file(path).text()).split("\n")) {
  if (!line.startsWith("{")) continue;
  const r = JSON.parse(line);
  if (r.repository !== repository) continue;
  if (r.msg === "Repository finished") console.log(JSON.stringify({ result: r.result, exitCode: r.exitCode }));
  if (r.msg !== "packageFiles with updates") continue;
  for (const [m, files] of Object.entries(r.config ?? r.packageFiles ?? {})) {
    if (manager && m !== manager) continue;
    for (const file of files)
      for (const d of file.deps)
        console.log(JSON.stringify({ manager: m, file: file.packageFile, name: d.depName, package: d.packageName, source: d.datasource, current: d.currentValue, version: d.currentVersion, digest: d.currentDigest, skip: d.skipReason, updates: d.updates, registry: d.registryUrls }));
  }
}
