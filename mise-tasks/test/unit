#!/usr/bin/env bash
#MISE description="Test the workspace through mbx, without the real lockfile tool tests"
#USAGE flag "--part <part>" default="all" help="all, or one half for CI: update (patchula-update, the slowest suite) or others (every other crate)" {
#USAGE   choices "all" "update" "others"
#USAGE }
set -euo pipefail
case "${usage_part:?}" in
  all) packages=(--workspace) ;;
  update) packages=(-p patchula-update) ;;
  others) packages=(--workspace --exclude patchula-update) ;;
esac
exec cargo test "${packages[@]}" --locked --no-fail-fast -- --skip lockfiles::tests::real_
