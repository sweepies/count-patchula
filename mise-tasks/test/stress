#!/usr/bin/env nu
#MISE description="Repeat the offline suite with varied test thread counts; logs stay outside the repository"
#MISE env.CARGO_NET_OFFLINE = "true"
#MISE env.PATCHULA_RECORD = "0"
# The same lockfile engines as test:tools; a unit test keeps the pins equal.
#MISE tools.aube = "2.8.1"
#MISE tools.bun = "1.4.3"
#MISE tools.yarn = "4.18.1"
#MISE tools.python = "3.14.8"
#MISE tools.uv = "0.13.1"
#MISE tools.poetry = "2.5.1"
#MISE tools.dotnet = "9.0.319"
#MISE tools.ruby = "3.4.11"
#MISE tools.apm = "0.35.0"
#MISE tools."http:php[url=https://dl.static-php.dev/static-php-cli/common/php-{{version}}-cli-linux-x86_64.tar.gz]" = "8.5.8"
#MISE tools."http:composer[url=https://getcomposer.org/download/{{version}}/composer.phar,bin=composer]" = "2.10.3"
#MISE tools."http:nix[url=https://hydra.nixos.org/build/350797336/download/2/nix,checksum=sha256:5d580d993636e3b987868881776214a7d4a169434715ec30bf9ead9345d78fb6,bin=nix]" = "2.35.5"
#USAGE flag "--runs <runs>" default="12" help="Iterations of the whole suite"
#USAGE flag "--filter <filter>" default="" help="Only run tests whose names contain this"
#USAGE flag "--log-dir <dir>" default="/tmp/patchula-stress" help="Where each run's log goes"

def main [--runs: int = 12, --filter: string = "", --log-dir: string = "/tmp/patchula-stress"] {
  mkdir $log_dir
  let filter = if $filter == "" { [] } else { [$filter] }
  for iteration in 1..$runs {
    for threads in [1 2 16] {
      let log = $log_dir | path join $"($iteration)-($threads).log"
      try {
        ^cargo test --workspace --locked -- $"--test-threads=($threads)" ...$filter o+e> $log
      } catch {
        print --raw --no-newline (open --raw $log)
        exit 1
      }
      print $"passed iteration=($iteration) threads=($threads)"
    }
  }
}
