// Count Patchula keeps his own repository up to date, through
// .github/workflows/patchula.yml.
amends "PatchulaConfig.pkl"

// defaults.toml lists the tools his lockfile jobs install by default, in
// mise's own format, so mise reads it beside the usual mise files. tasks.toml
// pins the same tools in the `test:tools` task, and a unit test keeps the two
// equal. A tool that is in more than one of these files moves in all of them
// on one branch.
files {
  new FileSet {
    manager = "mise"
    paths {
      "**/mise.toml"
      "**/.mise.toml"
      "**/.tool-versions"
      "crates/tools/src/lockfiles/defaults.toml"
      "tasks.toml"
    }
  }
}

rules {
  new Rule {
    note =
      "mise, php and composer are installed outside mise's registry: mise itself, a static PHP build and Composer's own download. mise cannot look them up by these names, so they move by hand."
    select {
      files { "crates/tools/src/lockfiles/defaults.toml" }
      packages { "mise"; "php"; "composer" }
    }
    apply { active = false }
  }
}
