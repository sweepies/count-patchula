// Count Patchula keeps his own repository up to date, through
// .github/workflows/patchula.yml.
amends "PatchulaConfig.pkl"

// defaults.toml lists the tools his lockfile jobs install by default, in
// mise's own format, so mise reads it beside the usual mise files. tasks.toml
// pins the same tools in the `test:tools` task, and a unit test keeps the two
// equal. A tool that is in more than one of these files moves in all of them
// on one branch.
files {
  new FileSet {
    manager = "mise"
    paths {
      "**/mise.toml"
      "**/.mise.toml"
      "**/.tool-versions"
      "crates/update/src/lockfiles/defaults.toml"
      "tasks.toml"
    }
  }
}

rules {
  new Rule {
    note = "Classic Yarn stays on 1.x; Yarn Berry is pinned on its own line below it."
    select {
      files { "crates/update/src/lockfiles/defaults.toml" }
      packages { "yarn" }
    }
    apply { permitted = "semver:^1" }
  }
  new Rule {
    note =
      "The test:tools task pins Yarn Berry, which defaults.toml keeps under [yarn] where the Count does not read it. It moves by hand, with that line."
    select {
      files { "tasks.toml" }
      packages { "yarn" }
    }
    apply { active = false }
  }
}
